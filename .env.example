# --- ASAAS PAYMENTS INTEGRATION (PHASE 1) ---
# Environment URL:
# For Sandbox: https://sandbox.asaas.com/api/v3
# For Production: https://api.asaas.com/api/v3
ASAAS_API_URL=https://sandbox.asaas.com/api/v3

# Asaas API Key / Access Token (Generated in Minha Conta > Integrações > Chaves de API)
ASAAS_API_KEY=

# Asaas Webhook Security Token (Configured in Asaas Webhook settings and received in 'asaas-access-token' header)
ASAAS_WEBHOOK_TOKEN=

# SaaS Plan Configuration
ASAAS_PLAN_VALUE=59.90
ASAAS_TRIAL_DAYS=14

# --- GMAIL SMTP SUPPORT TEAM ---
# For sending automatic contact and support tickets directly to Gmail
# IMPORTANT: For SUPPORT_EMAIL_PASS, use a 16-character "App Password" (Senha de App) from Google Security, NOT your raw account password.
# Steps: Account -> Security -> 2-Step Verification -> App Passwords
SUPPORT_EMAIL_USER=barbertoolsuporte@gmail.com
SUPPORT_EMAIL_PASS=

# --- ADMIN API AUTH KEY ---
# API Key to secure /api/admin/global-metrics against unauthorized access
ADMIN_API_KEY=barbertool_fallback_key_2026

