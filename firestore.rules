rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helpers ---
    function isSignedIn() {
      return request.auth != null;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isMemberOf(barbershopId) {
      return isSignedIn() && getUserData().barbershopId == barbershopId;
    }

    function isAdminOf(barbershopId) {
      return isMemberOf(barbershopId) && getUserData().role == 'admin';
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // --- Entity-Specific Validation ---

    function isValidBarbershop(data) {
      return data.name is string && data.name.size() > 0 && data.name.size() <= 100
        && data.slug is string && data.slug.size() > 0 && data.slug.size() <= 100;
    }

    function isValidUser(data) {
      return data.name is string && data.name.size() > 0
        && data.email is string && data.email.size() > 0
        && data.barbershopId is string
        && data.role in ['admin', 'barber'];
    }

    function isValidService(data) {
      return data.name is string && data.name.size() > 0
        && data.price is number && data.price >= 0
        && data.duration is number && data.duration > 0
        && data.barbershopId is string;
    }

    function isValidAppointment(data) {
      return data.customerName is string && data.customerName.size() > 0
        && data.customerPhone is string && data.customerPhone.size() > 0
        && data.date is string // format check would be complex in rules
        && data.barbershopId is string
        && data.userId is string
        && data.serviceId is string;
    }

    function isValidCustomer(data) {
      return data.name is string && data.name.size() > 0
        && data.phone is string && data.phone.size() > 0
        && data.barbershopId is string;
    }

    function isValidNotification(data) {
      return data.title is string && data.title.size() > 0
        && data.message is string && data.message.size() > 0
        && data.type is string
        && data.barbershopId is string;
    }

    // --- Match Rules ---

    match /barbershops/{barbershopId} {
      allow get: if true; // Public profiles
      allow list: if isSignedIn(); // Logged in users can see shops
      allow create: if isSignedIn() && isValidBarbershop(incoming());
      allow update: if isAdminOf(barbershopId) && isValidBarbershop(incoming())
        && incoming().createdAt == existing().createdAt;
    }

    match /users/{userId} {
      allow get: if isSignedIn() && (request.auth.uid == userId || getUserData().barbershopId == existing().barbershopId);
      allow create: if isSignedIn() && request.auth.uid == userId && isValidUser(incoming());
      allow update: if isSignedIn() && (request.auth.uid == userId || isAdminOf(existing().barbershopId)) 
        && isValidUser(incoming())
        && (request.auth.uid == userId ? incoming().role == existing().role : true); // Self cannot elevate role
    }

    match /barbershops/{barbershopId}/services/{serviceId} {
      allow read: if true; // Public can see services to book
      allow create: if isAdminOf(barbershopId) && isValidService(incoming());
      allow update: if isAdminOf(barbershopId) && isValidService(incoming());
      allow delete: if isAdminOf(barbershopId);
    }

    match /barbershops/{barbershopId}/appointments/{appointmentId} {
      allow read: if isMemberOf(barbershopId);
      allow create: if true; // External booking allowed
      allow update: if isMemberOf(barbershopId) && isValidAppointment(incoming());
      allow delete: if isAdminOf(barbershopId);
    }

    match /barbershops/{barbershopId}/customers/{customerId} {
      allow read: if isMemberOf(barbershopId);
      allow write: if isMemberOf(barbershopId) && isValidCustomer(incoming());
    }

    match /barbershops/{barbershopId}/notifications/{notificationId} {
      allow read: if isMemberOf(barbershopId);
      allow write: if isMemberOf(barbershopId) && isValidNotification(incoming());
    }
  }
}
